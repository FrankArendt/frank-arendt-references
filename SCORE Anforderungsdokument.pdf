-- =====================================================================
-- SCORE ‚Äî DuckDB-Schema
-- =====================================================================
-- Enth√§lt:
--   1. Sequenzen f√ºr Prim√§rschl√ºssel
--   2. Tabelle score_db            (Fallspeicher, Kapitel 5.1)
--   3. Tabelle zeitreihen_db        (Gewichtungs-/Kostenverlauf, Kapitel 5.2)
--   4. View v_zeitreihen_aktuell    (neueste Gewichte je Messgr√∂sse/Modul)
--      View v_fuzzy_distanz         (gewichtete Distanzberechnung, Kapitel 7)
--   5. Trigger-Ersatzmechanik       (Zeitstempel bei INSERT / Status-UPDATE)
--   6. View v_score_db_export       (60 inhaltlich benannte Messwert-Spalten)
--   7. DB-Benutzer & Zugriffsrechte (Least Privilege, Kapitel 8.3)
--   8. seed_score_testdaten()       (Prozedur/Makro zum Anlegen von Testdaten)
--
-- WICHTIGER HINWEIS ZU TRIGGERN
-- -----------------------------------------------------------------------
-- DuckDB unterstuetzt (Stand 2026) KEINE CREATE TRIGGER-Syntax. Die beiden
-- geforderten Trigger werden daher DuckDB-idiomatisch umgesetzt:
--   * "on insert timestamp des Datensatzes"  -> Spalten-DEFAULT now()
--     (feuert automatisch bei jedem INSERT, exakt wie ein BEFORE-INSERT-Trigger).
--   * "on update status timestamp setzen"     -> die Statusaenderung erfolgt
--     ausschliesslich ueber die vordefinierte UPDATE-Anweisung / das Makro
--     update_status(), das zeitstempel_statusaenderung = now() mitsetzt.
-- Zusaetzlich ist unten der aequivalente CREATE-TRIGGER-Code als Kommentar
-- hinterlegt, falls das Schema spaeter auf eine Trigger-faehige Engine
-- (z. B. PostgreSQL, siehe Kapitel 13.2) portiert wird.
-- =====================================================================


-- =====================================================================
-- 1. SEQUENZEN (fuer Autoincrement-Primaerschluessel)
-- =====================================================================
CREATE SEQUENCE IF NOT EXISTS seq_score_db_pk    START 1;
CREATE SEQUENCE IF NOT EXISTS seq_zeitreihen_pk  START 1;


-- =====================================================================
-- 2. TABELLE score_db  (Fallspeicher, Kapitel 5.1)
-- =====================================================================
CREATE TABLE IF NOT EXISTS score_db (
    -- Primaerschluessel: automatisch generiert
    pk                          BIGINT       PRIMARY KEY
                                             DEFAULT nextval('seq_score_db_pk'),

    -- Zeitstempel des Datensatzes: wird per INSERT-DEFAULT gesetzt
    -- (entspricht "Trigger on insert" -> setzt Timestamp des Datensatzes selbst)
    zeitstempel                 TIMESTAMP    NOT NULL DEFAULT now(),

    -- Messgroessen-Vektor: 60 auf 0..100 normierte Werte.
    -- Als DOUBLE[]-Array modelliert; Index 1..60 entspricht Messgroesse-ID 1..60.
    messgroessen_vektor         DOUBLE[]     NOT NULL,

    -- Verwendetes Verarbeitungsmodul (freier Modulname, nicht auf Werteliste beschraenkt)
    verwendetes_modul           VARCHAR      NOT NULL,

    -- Tokenverbrauch des Verarbeitungslaufs
    token_anzahl                BIGINT       DEFAULT 0,

    -- Kostenfaktor und daraus berechnete Gesamtkosten
    kostenfaktor                DOUBLE       DEFAULT 0,
    kosten_gesamt               DOUBLE       DEFAULT 0,

    -- Status der Verarbeitung
    status                      VARCHAR      NOT NULL DEFAULT 'in Bearbeitung'
                                CHECK (status IN (
                                    'in Bearbeitung',
                                    'erfolgreich',
                                    'manuelle Nachbearbeitung erforderlich'
                                )),

    -- Zeitpunkt der letzten Statusaenderung.
    -- Initial = Erstellzeit; wird bei jeder Statusaenderung neu gesetzt
    -- (entspricht "Trigger on update status").
    zeitstempel_statusaenderung TIMESTAMP    NOT NULL DEFAULT now(),

    -- Referenz auf ein Folgesystem (z. B. DATEV-Belegnummer)
    referenz_folgesystem        VARCHAR,

    -- Gewichteter Aehnlichkeitswert zum verwendeten Referenzdatensatz (Nachvollziehbarkeit)
    fuzzy_distanz               DOUBLE,

    -- Erkannte Felder + Log-Informationen des Verarbeitungslaufs (JSON)
    daten                       JSON
);


-- =====================================================================
-- 3. TABELLE zeitreihen_db  (Gewichtungs-/Kostenverlauf, Kapitel 5.2)
-- -----------------------------------------------------------------------
-- APPEND-ONLY: jeder Housekeeping-Lauf schreibt je Messgroesse und Modul
-- einen neuen, mit Zeitstempel versehenen Datensatz (Historisierung fuer
-- die Predictability-Ansicht, Kapitel 8.2). Fuer die operative Nutzung
-- wird stets der jeweils AKTUELLSTE Datensatz je (messgroesse_id, modul)
-- herangezogen (siehe View v_zeitreihen_aktuell unten).
-- =====================================================================
CREATE TABLE IF NOT EXISTS zeitreihen_db (
    pk                          BIGINT       PRIMARY KEY
                                             DEFAULT nextval('seq_zeitreihen_pk'),

    -- Referenz auf eine der 60 Messgroessen (1..60)
    messgroesse_id              INTEGER      NOT NULL
                                CHECK (messgroesse_id BETWEEN 1 AND 60),

    -- Verarbeitungsmodul (Gewichte gelten je Modul separat)
    verarbeitungsmodul          VARCHAR      NOT NULL,

    -- Vom Housekeeping-Prozess ermittelter Gewichtungsfaktor w_i (= Predictability)
    gewichtungsfaktor_w         DOUBLE       NOT NULL DEFAULT 1.0,

    -- Aktuell gueltiger Umrechnungsfaktor Token -> Kosten fuer dieses Modul
    kostenfaktor_je_token       DOUBLE       DEFAULT 0,

    -- Zeitpunkt des Housekeeping-Laufs, der diesen Datensatz geschrieben hat
    -- (per INSERT-DEFAULT gesetzt)
    zeitstempel_letzte_aktualisierung TIMESTAMP NOT NULL DEFAULT now()
);


-- =====================================================================
-- 4a. HILFS-VIEW: jeweils AKTUELLSTE Gewichte je Messgroesse/Modul
-- -----------------------------------------------------------------------
-- Aus der append-only-Zeitreihe wird per Fensterfunktion der neueste
-- Datensatz je (messgroesse_id, verarbeitungsmodul) selektiert.
-- =====================================================================
CREATE OR REPLACE VIEW v_zeitreihen_aktuell AS
SELECT
    messgroesse_id,
    verarbeitungsmodul,
    gewichtungsfaktor_w,
    kostenfaktor_je_token,
    zeitstempel_letzte_aktualisierung
FROM (
    SELECT
        z.*,
        ROW_NUMBER() OVER (
            PARTITION BY messgroesse_id, verarbeitungsmodul
            ORDER BY zeitstempel_letzte_aktualisierung DESC
        ) AS rn
    FROM zeitreihen_db z
) t
WHERE rn = 1;


-- =====================================================================
-- 4b. FUZZY-VIEW: gewichtete Distanzberechnung (Kapitel 7)
-- -----------------------------------------------------------------------
-- Berechnet fuer JEDEN erfolgreichen Referenzdatensatz der score_db die
-- gewichtete quadrierte euklidische Distanz zu einem Anfragevektor:
--
--     Distanz = SUM_i [ w_i * (m_referenz,i - m_anfrage,i)^2 ]
--
-- Die Gewichte w_i stammen je Messgroesse aus der Zeitreihen-Tabelle
-- (Subquery auf v_zeitreihen_aktuell, passend zum Modul des Referenz-
-- datensatzes). Der Anfragevektor wird ueber die Parametertabelle
-- fuzzy_anfrage bereitgestellt (genau eine Zeile, Vektor der aktuellen Datei).
--
-- Nutzung im Hauptprozess:
--   1. fuzzy_anfrage mit dem aktuellen Messgroessen-Vektor befuellen,
--   2. SELECT ... FROM v_fuzzy_distanz LIMIT 1  (nur der aehnlichste Datensatz).
--      Es wird genau EIN Datensatz zurueckgeliefert; dessen verwendetes_modul
--      ist der Verfahrensvorschlag. (Frueher Top-3 mit anschliessender
--      Kostenauswahl; die Kostenoptimierung erfolgt nun ueber die
--      Eskalationslogik, Kapitel 6.2.)
-- =====================================================================

-- Parametertabelle fuer den Anfragevektor (genau eine aktive Zeile)
CREATE TABLE IF NOT EXISTS fuzzy_anfrage (
    id                  INTEGER PRIMARY KEY DEFAULT 1,
    messgroessen_vektor DOUBLE[] NOT NULL,
    CHECK (id = 1)   -- erzwingt Singleton
);

CREATE OR REPLACE VIEW v_fuzzy_distanz AS
WITH anfrage AS (
    -- Anfragevektor in (Index, Wert) entpacken: Index 1..60
    SELECT
        idx                             AS messgroesse_id,
        messgroessen_vektor[idx]        AS wert_anfrage
    FROM fuzzy_anfrage,
         UNNEST(range(1, 61)) AS u(idx)   -- range(1,61) -> 1..60
),
referenz AS (
    -- Nur erfolgreiche Referenzdatensaetze ohne manuelle Nachbearbeitung
    SELECT
        s.pk,
        s.verwendetes_modul,
        s.kosten_gesamt,
        idx                             AS messgroesse_id,
        s.messgroessen_vektor[idx]      AS wert_referenz
    FROM score_db s,
         UNNEST(range(1, 61)) AS u(idx)
    WHERE s.status = 'erfolgreich'
),
gewichtete_differenzen AS (
    SELECT
        r.pk,
        r.verwendetes_modul,
        r.kosten_gesamt,
        -- Gewicht w_i je Messgroesse und Modul als Subquery aus der Zeitreihe;
        -- fehlt ein Wert, wird neutral mit 1.0 gewichtet (COALESCE).
        COALESCE((
            SELECT za.gewichtungsfaktor_w
            FROM v_zeitreihen_aktuell za
            WHERE za.messgroesse_id     = r.messgroesse_id
              AND za.verarbeitungsmodul = r.verwendetes_modul
        ), 1.0)
        * POWER(r.wert_referenz - a.wert_anfrage, 2) AS gew_quadrat_diff
    FROM referenz r
    JOIN anfrage a
      ON a.messgroesse_id = r.messgroesse_id
)
SELECT
    pk,
    verwendetes_modul,
    kosten_gesamt,
    SUM(gew_quadrat_diff)               AS distanz
FROM gewichtete_differenzen
GROUP BY pk, verwendetes_modul, kosten_gesamt
ORDER BY distanz ASC;


-- =====================================================================
-- 5. TRIGGER-ERSATZMECHANIK
-- =====================================================================
-- 5a. INSERT-Zeitstempel:
--     Bereits ueber Spalten-DEFAULT now() geloest (siehe Tabellendefinition).
--     Ein INSERT ohne Angabe von zeitstempel / zeitstempel_letzte_aktualisierung
--     setzt den Timestamp automatisch:
--
--     INSERT INTO score_db (messgroessen_vektor, verwendetes_modul)
--     VALUES ([/* 60 Werte */], 'Low-Cost-OCR');
--     -> zeitstempel und zeitstempel_statusaenderung = now()

-- 5b. Status-UPDATE-Zeitstempel:
--     Da DuckDB keine Trigger kennt, erfolgt jede Statusaenderung ueber ein
--     Makro, das den Aenderungs-Zeitstempel zwingend mitsetzt. Dadurch kann
--     der Status nicht ohne Aktualisierung von zeitstempel_statusaenderung
--     geaendert werden.
CREATE OR REPLACE MACRO update_status(p_pk, p_neuer_status) AS TABLE
    UPDATE score_db
       SET status                      = p_neuer_status,
           zeitstempel_statusaenderung = now()
     WHERE pk = p_pk;

--     Aufruf-Beispiel:
--     FROM update_status(8841, 'erfolgreich');
--
--     Alternativ direkt (immer beide Felder zusammen setzen):
--     UPDATE score_db
--        SET status = 'manuelle Nachbearbeitung erforderlich',
--            zeitstempel_statusaenderung = now()
--      WHERE pk = 8841;


-- =====================================================================
-- 5c. AEQUIVALENTE ECHTE TRIGGER (nur fuer Portierung auf PostgreSQL,
--     Kapitel 13.2 ‚Äî in DuckDB auskommentiert lassen!)
-- ---------------------------------------------------------------------
-- CREATE OR REPLACE FUNCTION trg_score_insert() RETURNS trigger AS $$
-- BEGIN
--     NEW.zeitstempel                 := now();
--     NEW.zeitstempel_statusaenderung := now();
--     RETURN NEW;
-- END; $$ LANGUAGE plpgsql;
--
-- CREATE TRIGGER score_before_insert
--     BEFORE INSERT ON score_db
--     FOR EACH ROW EXECUTE FUNCTION trg_score_insert();
--
-- CREATE OR REPLACE FUNCTION trg_score_status_update() RETURNS trigger AS $$
-- BEGIN
--     IF NEW.status IS DISTINCT FROM OLD.status THEN
--         NEW.zeitstempel_statusaenderung := now();
--     END IF;
--     RETURN NEW;
-- END; $$ LANGUAGE plpgsql;
--
-- CREATE TRIGGER score_before_update_status
--     BEFORE UPDATE OF status ON score_db
--     FOR EACH ROW EXECUTE FUNCTION trg_score_status_update();
-- =====================================================================


-- =====================================================================
-- 6. EXPORT-VIEW: score_db mit inhaltlich benannten Messwert-Spalten
-- ---------------------------------------------------------------------
-- Entpackt den messgroessen_vektor (DOUBLE[]) in 60 einzeln benannte
-- Spalten (snake_case gemaess DuckDB-Namenskonvention). Dient dem
-- Export/der Analyse (z. B. ML-Training, BI-Tools), wo sprechende
-- Spaltennamen statt Array-Indizes benoetigt werden.
-- Jede Spalte ist unten ausfuehrlich kommentiert.
-- =====================================================================
CREATE OR REPLACE VIEW v_score_db_export AS
SELECT
    pk,
    zeitstempel,
    verwendetes_modul,
    token_anzahl,
    kostenfaktor,
    kosten_gesamt,
    status,
    zeitstempel_statusaenderung,
    referenz_folgesystem,
    fuzzy_distanz,
    -- --- 60 Messwerte (Index im Array 1..60) ---
    messgroessen_vektor[1] AS bildaufloesung_ppi,  -- Messgroesse 1: Bildaufl√∂sung relativ zur Zeichenh√∂he (PPI). Misst, wie fein der Beleg abgetastet wurde; zu geringe Aufl√∂sung f√ºhrt zu verwaschenen Zeichen und OCR-Fehlern.
    messgroessen_vektor[2] AS kontrast_rms,  -- Messgroesse 2: RMS-Kontrast: Standardabweichung der Helligkeitswerte. Niedriger Kontrast (blasse Schrift auf hellem Grund) erschwert die Zeichen-Hintergrund-Trennung.
    messgroessen_vektor[3] AS schaerfe_laplace_varianz,  -- Messgroesse 3: Sch√§rfe gemessen als Varianz des Laplace-Operators. Niedrige Werte deuten auf Unsch√§rfe/Defokus hin, die Kanteninformation der Zeichen zerst√∂rt.
    messgroessen_vektor[4] AS belichtung_histogramm_clipping,  -- Messgroesse 4: Belichtung als Anteil abgeschnittener Histogramm-Extreme (Clipping). √úber-/Unterbelichtung l√§sst Zeichen in Weiss- oder Schwarzfl√§chen verschwinden.
    messgroessen_vektor[5] AS bildrauschen_std_homogen,  -- Messgroesse 5: Bildrauschen als Standardabweichung in homogenen Fl√§chen. Hohes Rauschen erzeugt St√∂rpixel, die als falsche Zeichenbestandteile interpretiert werden.
    messgroessen_vektor[6] AS schraeglage_skew_hough,  -- Messgroesse 6: Schr√§glage/Skew-Winkel via Hough-Transformation. Geneigte Textzeilen verschlechtern zeilenbasierte OCR-Segmentierung.
    messgroessen_vektor[7] AS otsu_trennschaerfe,  -- Messgroesse 7: Otsu-Trennsch√§rfe (Inter-Klassen-Varianz). Misst, wie klar sich Vorder- von Hintergrund per Schwellwert trennen l√§sst ‚Äî Grundlage der Binarisierung.
    messgroessen_vektor[8] AS kantendichte_sobel,  -- Messgroesse 8: Kantendichte √ºber Sobel-Gradient. Indikator f√ºr die Menge an Zeichenkonturen; sehr niedrig = kaum Text, sehr hoch = m√∂gliche St√∂rstrukturen.
    messgroessen_vektor[9] AS ink_coverage,  -- Messgroesse 9: Tinten-Fl√§chenanteil (Ink Coverage): Anteil dunkler Pixel. Zu wenig = leerer Beleg, zu viel = √ºberf√ºllt/verschmiert.
    messgroessen_vektor[10] AS kompressionsartefakte_blockiness,  -- Messgroesse 10: Kompressionsartefakte als 8√ó8-Blockiness. JPEG-Blockstrukturen verf√§lschen feine Zeichenkonturen.
    messgroessen_vektor[11] AS farbtiefe_kanalanzahl,  -- Messgroesse 11: Farbtiefe bzw. Kanalanzahl (Graustufe vs. Farbe). Beeinflusst, welche Vorverarbeitung sinnvoll ist.
    messgroessen_vektor[12] AS byte_pro_pixel,  -- Messgroesse 12: Byte pro Pixel als Mass der effektiven Kompressionsrate. Sehr niedrige Werte deuten auf starke, verlustbehaftete Kompression hin.
    messgroessen_vektor[13] AS seitenverhaeltnis_plausibilitaet,  -- Messgroesse 13: Plausibilit√§t des Seitenverh√§ltnisses. Ungew√∂hnliche Verh√§ltnisse weisen auf Beschnitt oder falsche Ausrichtung hin.
    messgroessen_vektor[14] AS bildgroesse_pixelzahl,  -- Messgroesse 14: Absolute Bildgr√∂sse (Gesamtpixelzahl). Zu kleine Bilder tragen zu wenig Information f√ºr zuverl√§ssige Erkennung.
    messgroessen_vektor[15] AS farbstich_cast,  -- Messgroesse 15: Farbstich/Cast als Kanalabweichung. Starker Farbstich (z. B. Gelbstich alter Scans) kann Binarisierung st√∂ren.
    messgroessen_vektor[16] AS saettigung_mittel,  -- Messgroesse 16: Mittlere Farbs√§ttigung. Hilft, farbige St√∂relemente von neutralem Text zu unterscheiden.
    messgroessen_vektor[17] AS dynamikumfang_spannweite,  -- Messgroesse 17: Dynamikumfang als Histogramm-Spannweite. Geringe Spannweite = flaues Bild mit schlechter Zeichenabgrenzung.
    messgroessen_vektor[18] AS bild_entropie,  -- Messgroesse 18: Bild-Entropie als Mass des Informationsgehalts. Sehr niedrige Entropie deutet auf leere/uniforme Belege hin.
    messgroessen_vektor[19] AS histogramm_peakanzahl,  -- Messgroesse 19: Anzahl Histogramm-Peaks (Bimodalit√§t). Klar bimodale Verteilung beg√ºnstigt saubere Schwarz-Weiss-Trennung.
    messgroessen_vektor[20] AS weissraum_anteil,  -- Messgroesse 20: Weissraum-Anteil. Sehr hoher Anteil = wenig Text; sehr niedriger = dichte, schwer trennbare Layouts.
    messgroessen_vektor[21] AS vignettierung_gradient,  -- Messgroesse 21: Vignettierung/Beleuchtungsgradient. Ungleichm√§ssige Ausleuchtung erschwert globale Schwellwertverfahren.
    messgroessen_vektor[22] AS schatten_raender,  -- Messgroesse 22: Schattenanteil an den R√§ndern. Typisch bei Handy-Fotos; Randschatten k√∂nnen Zeichen verdecken.
    messgroessen_vektor[23] AS glanzlicht_specular_flaeche,  -- Messgroesse 23: Glanzlicht-/Specular-Highlight-Fl√§che. Reflexionen (z. B. auf Thermopapier) l√∂schen lokal Zeicheninformation.
    messgroessen_vektor[24] AS randbeschnitt_vorhanden,  -- Messgroesse 24: Bildrahmen/Randbeschnitt vorhanden. Zeigt an, ob der Beleg vollst√§ndig erfasst oder angeschnitten wurde.
    messgroessen_vektor[25] AS seitenwoelbung_kruemmung,  -- Messgroesse 25: Seitenw√∂lbung (Buchscan-Kr√ºmmung). Gekr√ºmmte Zeilen verzerren Zeichen und Zeilenverlauf.
    messgroessen_vektor[26] AS perspektivische_verzerrung,  -- Messgroesse 26: Perspektivische Verzerrung. Schr√§g fotografierte Belege verzerren Zeichenproportionen.
    messgroessen_vektor[27] AS bildrotation_grob,  -- Messgroesse 27: Grobe Bildrotation (0/90/180/270¬∞). Falsche Orientierung macht OCR ohne Vorab-Drehung unm√∂glich.
    messgroessen_vektor[28] AS moire_fft_peak,  -- Messgroesse 28: Moir√©-Muster-St√§rke via FFT-Peak. Interferenzmuster (Rescan von Rasterdruck) √ºberlagern Zeichen.
    messgroessen_vektor[29] AS farbquantisierung_stufen,  -- Messgroesse 29: Farbquantisierungs-Stufen. Starke Quantisierung (wenige Farben) kann feine Kanten zerst√∂ren.
    messgroessen_vektor[30] AS salt_pepper_anteil,  -- Messgroesse 30: Salt-and-Pepper-Rauschanteil. Isolierte schwarze/weisse St√∂rpixel werden leicht als Zeichenteile fehlinterpretiert.
    messgroessen_vektor[31] AS bewegungsunschaerfe_richtung,  -- Messgroesse 31: Bewegungsunsch√§rfe (gerichteter Gradient). Verwischte Zeichen durch Kamerabewegung.
    messgroessen_vektor[32] AS gaussian_blur_schaetzwert,  -- Messgroesse 32: Gesch√§tzter Gaussian-Blur-Grad. Allgemeine Weichzeichnung, die Kanten aufweicht.
    messgroessen_vektor[33] AS farbkanal_snr,  -- Messgroesse 33: Farbkanal-Rauschverh√§ltnis (SNR). Niedriges Signal-Rausch-Verh√§ltnis mindert Erkennbarkeit.
    messgroessen_vektor[34] AS chromatische_aberration,  -- Messgroesse 34: Chromatische Aberration (RGB-Kantenversatz). Farbs√§ume an Kanten verwischen Zeichenkonturen.
    messgroessen_vektor[35] AS bit_tiefe,  -- Messgroesse 35: Bit-Tiefe (8/16/32 Bit). Beeinflusst die verf√ºgbare Tonwertaufl√∂sung.
    messgroessen_vektor[36] AS kompressionstyp,  -- Messgroesse 36: Dateiformat-Kompressionstyp (verlustfrei vs. verlustbehaftet). Verlustbehaftung korreliert mit Artefakten.
    messgroessen_vektor[37] AS jpeg_qualitaet_dct,  -- Messgroesse 37: JPEG-Qualit√§tssch√§tzung via DCT-Analyse. Niedrige gesch√§tzte Qualit√§t = mehr Artefakte.
    messgroessen_vektor[38] AS lokale_kontrastvarianz,  -- Messgroesse 38: Lokale Kontrastvarianz (fensterweise). Ungleichm√§ssiger Kontrast √ºber das Bild hinweg.
    messgroessen_vektor[39] AS texturkomplexitaet_glcm,  -- Messgroesse 39: Texturkomplexit√§t (GLCM-Homogenit√§t). Unterscheidet glatte Hintergr√ºnde von strukturiertem Text.
    messgroessen_vektor[40] AS symmetrie_abweichung,  -- Messgroesse 40: Symmetrie-/Spiegelabweichung (bei Formularen). Misst Ausrichtungsfehler strukturierter Vorlagen.
    messgroessen_vektor[41] AS hintergrund_uniformitaet,  -- Messgroesse 41: Hintergrundfarb-Uniformit√§t. Ungleichm√§ssiger Hintergrund erschwert Text-Freistellung.
    messgroessen_vektor[42] AS staub_kratzer,  -- Messgroesse 42: Staub-/Kratzer-Erkennung (isolierte Ausreisser). Physische Defekte auf Scans.
    messgroessen_vektor[43] AS wasserzeichen_stempel,  -- Messgroesse 43: Wasserzeichen-/Stempel√ºberlagerung. Halbtransparente √úberlagerungen st√∂ren Zeichen.
    messgroessen_vektor[44] AS tabellen_linienstruktur,  -- Messgroesse 44: Tabellen-/Linienstruktur (Hough horizontal/vertikal). Erkennt Formular- und Tabellenlinien.
    messgroessen_vektor[45] AS spaltenanzahl_schaetzung,  -- Messgroesse 45: Spaltenanzahl-Sch√§tzung (vertikale L√ºcken). Mehrspaltige Layouts erfordern besondere Segmentierung.
    messgroessen_vektor[46] AS textzeilen_anzahl_schaetzung,  -- Messgroesse 46: Textzeilen-Anzahl-Sch√§tzung (horizontale Projektion). Grobmass f√ºr die Textmenge.
    messgroessen_vektor[47] AS zeilenabstand_konsistenz,  -- Messgroesse 47: Zeilenabstand-Konsistenz (Projektionsprofil-Peaks). Unregelm√§ssige Abst√§nde erschweren Zeilentrennung.
    messgroessen_vektor[48] AS connected_components_anzahl,  -- Messgroesse 48: Connected-Components-Anzahl (Layout-Grobmass). Zahl zusammenh√§ngender Objekte als Komplexit√§tsindikator.
    messgroessen_vektor[49] AS vorder_hintergrund_verhaeltnis,  -- Messgroesse 49: Verh√§ltnis Vorder-/Hintergrundfl√§che. Balance zwischen Text und Leerraum.
    messgroessen_vektor[50] AS randobjekt_beschnitt,  -- Messgroesse 50: Bildkanten-Beschnitt-Verlust (abgeschnittene Randobjekte). Zeigt verlorene Information am Bildrand an.
    messgroessen_vektor[51] AS zeichenhoehe_xheight,  -- Messgroesse 51: Zeichenh√∂he in Pixel (x-Height). Zu kleine Zeichen unterschreiten die zuverl√§ssige Erkennungsgr√∂sse.
    messgroessen_vektor[52] AS textflaechenanteil,  -- Messgroesse 52: Text-vs-Nichttext-Klassifikation (Textfl√§chenanteil). Anteil echter Textregionen am Bild.
    messgroessen_vektor[53] AS handschrift_indikator,  -- Messgroesse 53: Handschrift- vs. Druckschrift-Indikator. Handschrift erfordert andere Modelle als Maschinenschrift.
    messgroessen_vektor[54] AS lokale_schaerfe_varianz,  -- Messgroesse 54: Lokale Sch√§rfe-Varianz (Fokus-Ungleichm√§ssigkeit). Teilbereiche unterschiedlicher Sch√§rfe.
    messgroessen_vektor[55] AS glare_reflexion,  -- Messgroesse 55: Glanzlicht-/Reflexionsfl√§chen (Glare). Grossfl√§chige Reflexionen, die Text ausl√∂schen.
    messgroessen_vektor[56] AS show_through,  -- Messgroesse 56: Durchscheinen der R√ºckseite (Show-through). R√ºckseitentext scheint durch und st√∂rt die Erkennung.
    messgroessen_vektor[57] AS strichstaerke_konsistenz,  -- Messgroesse 57: Strichst√§rke/Stroke-Width-Konsistenz. Ungleichm√§ssige Strichst√§rken deuten auf Druck-/Scanprobleme hin.
    messgroessen_vektor[58] AS upsampling_erkennung,  -- Messgroesse 58: Upsampling-/Interpolations-Erkennung. K√ºnstlich hochskalierte Bilder haben keine echte Detailinformation.
    messgroessen_vektor[59] AS overlay_auf_text,  -- Messgroesse 59: Barcode-/Logo-/Stempel-Overlay auf Textbereich. √úberlagerungen direkt √ºber Text mindern Lesbarkeit.
    messgroessen_vektor[60] AS mehrfach_kompression_ghosting,  -- Messgroesse 60: Mehrfach-Kompressionsgenerationen (JPEG-Ghosting). Wiederholtes Speichern erzeugt kumulierte Artefakte.
    daten
FROM score_db;

-- =====================================================================
-- 7. DATENBANK-BENUTZER UND ZUGRIFFSRECHTE (Least Privilege, Kap. 8.3)
-- ---------------------------------------------------------------------
-- Umsetzung des Least-Privilege-Prinzips: jeder Dienst erhaelt einen
-- eigenen Benutzer mit exakt den benoetigten Rechten.
--
-- HINWEIS ZUR PORTIERUNG: DuckDB besitzt seit v1.1 ein experimentelles
-- Rechte-/Secret-System, das je nach Deployment (Einzeldatei vs. Server)
-- unterschiedlich ausfaellt. In einer reinen Einzeldatei-DuckDB gibt es
-- keine klassische Nutzerverwaltung; die Rechtetrennung wird dann auf
-- Ebene des vorgelagerten PostgreSQL-Clusters (Kap. 13.2) durchgesetzt.
-- Die folgenden Anweisungen sind in ANSI-SQL/PostgreSQL-Syntax gehalten
-- und dienen als verbindliche Rechte-Spezifikation fuer den persistenten
-- Cluster; auf einer DuckDB-Serverinstanz mit aktiviertem Auth-Layer sind
-- sie sinngemaess anwendbar.
-- =====================================================================

-- 7a. Rollen/Benutzer je Dienst
CREATE ROLE score_hauptprozess   LOGIN PASSWORD '***';  -- liest+schreibt Faelle, KEIN DELETE
CREATE ROLE score_housekeeping   LOGIN PASSWORD '***';  -- einziger Dienst mit DELETE-Recht
CREATE ROLE score_ml_service     LOGIN PASSWORD '***';  -- liest score_db, schreibt zeitreihen_db
CREATE ROLE dashboard_reader     LOGIN PASSWORD '***';  -- ausschliesslich lesend (Views)

-- 7b. Rechte Hauptprozess: Faelle anlegen, lesen, Status aktualisieren
GRANT SELECT, INSERT, UPDATE ON score_db            TO score_hauptprozess;
GRANT SELECT                 ON zeitreihen_db        TO score_hauptprozess;
GRANT SELECT                 ON v_zeitreihen_aktuell TO score_hauptprozess;
GRANT SELECT, INSERT, UPDATE ON fuzzy_anfrage        TO score_hauptprozess;
GRANT SELECT                 ON v_fuzzy_distanz       TO score_hauptprozess;
GRANT USAGE                  ON SEQUENCE seq_score_db_pk TO score_hauptprozess;

-- 7c. Rechte Housekeeping: als EINZIGER Dienst darf loeschen (Retention, Kap. 8.1)
GRANT SELECT, INSERT, UPDATE, DELETE ON score_db     TO score_housekeeping;
GRANT SELECT, INSERT            ON zeitreihen_db       TO score_housekeeping;  -- append-only
GRANT USAGE ON SEQUENCE seq_zeitreihen_pk             TO score_housekeeping;

-- 7d. Rechte ML-Service: liest Faelle, schreibt neue Gewichte (append-only)
GRANT SELECT          ON score_db                     TO score_ml_service;
GRANT SELECT          ON v_score_db_export            TO score_ml_service;
GRANT SELECT, INSERT  ON zeitreihen_db                TO score_ml_service;
GRANT USAGE ON SEQUENCE seq_zeitreihen_pk             TO score_ml_service;

-- 7e. Rechte Dashboard: ausschliesslich lesend auf definierte Views
GRANT SELECT ON v_zeitreihen_aktuell                  TO dashboard_reader;
GRANT SELECT ON v_score_db_export                     TO dashboard_reader;
-- (auf die Dashboard-Aggregat-Views v_dash_* aus Kapitel 8.2, sobald angelegt)


-- =====================================================================
-- 8. TESTDATEN-PROZEDUR
-- ---------------------------------------------------------------------
-- Legt eine konfigurierbare Anzahl zufaelliger, aber plausibler
-- Testdatensaetze in score_db an (Messwerte 0..100, zufaelliges Modul
-- und Status). Praktisch fuer Integrationstests (Kap. 14) und zum
-- Ausprobieren der Fuzzy-View.
--
-- DuckDB kennt keine CREATE PROCEDURE-Anweisung; eine parametrierbare
-- "Prozedur" wird daher als table-MACRO umgesetzt, das die INSERT-Logik
-- kapselt und per FROM aufgerufen wird.
-- =====================================================================
CREATE OR REPLACE MACRO seed_score_testdaten(p_anzahl) AS TABLE
    INSERT INTO score_db (
        messgroessen_vektor,
        verwendetes_modul,
        token_anzahl,
        kostenfaktor,
        kosten_gesamt,
        status,
        fuzzy_distanz,
        daten
    )
    SELECT
        -- 60 Zufallswerte 0..100 als DOUBLE[] erzeugen
        (SELECT list(round(random() * 100, 2))
           FROM range(1, 61))                                   AS messgroessen_vektor,
        -- zufaelliges Modul
        (['Low-Cost-OCR','LLM klein','LLM mittel','LLM gross']
            )[1 + CAST(floor(random() * 4) AS INTEGER)]         AS verwendetes_modul,
        CAST(floor(random() * 4000) AS BIGINT)                  AS token_anzahl,
        round(random() * 0.02, 5)                               AS kostenfaktor,
        round(random() * 0.10, 5)                               AS kosten_gesamt,
        -- ~70% erfolgreich, Rest Nachbearbeitung
        CASE WHEN random() < 0.7
             THEN 'erfolgreich'
             ELSE 'manuelle Nachbearbeitung erforderlich'
        END                                                     AS status,
        round(random() * 50, 3)                                 AS fuzzy_distanz,
        json_object('quelle', 'testdaten', 'lauf', i)           AS daten
    FROM range(1, CAST(p_anzahl AS BIGINT) + 1) AS t(i);

-- Aufruf-Beispiele:
--   FROM seed_score_testdaten(100);   -- 100 Testfaelle anlegen
--   SELECT count(*) FROM score_db;    -- Kontrolle
--
-- Beispielhafter Fuzzy-Testlauf nach dem Seeding:
--   -- Anfragevektor setzen (60 Werte):
